<Window x:Class="Vixxo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Vixxo.App.ViewModels"
        xmlns:audio="clr-namespace:Vixxo.Core.Audio;assembly=Vixxo.Core"
        mc:Ignorable="d"
        Title="Vixxo — Android Microphone Receiver"
        Height="820" Width="960"
        MinHeight="720" MinWidth="850"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Missing VB-CABLE Alert -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vixxo" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                    <Border Background="#1E293B" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="High-Fidelity Android to Windows Virtual Microphone" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PC IP: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PrimaryIpAddress}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" : " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ListenPort}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="14,6" Background="{Binding StatusColor}">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="ExtraBold" Foreground="#0F172A" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- VB-CABLE MISSING WARNING BANNER -->
        <Border Grid.Row="1" Background="#450A0A" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                Visibility="{Binding IsVbCableMissing, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="⚠️ VB-CABLE Driver Not Found" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" FontSize="14" />
                    <TextBlock Text="Virtual microphone streaming requires VB-CABLE. Please install it, then click Refresh Endpoints." Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Endpoints" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource OutlinedButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- MAIN TWO-COLUMN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!-- VIRTUAL AUDIO ROUTING CARD -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Virtual Microphone Routing" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="10,4" FontSize="11" />
                            </Grid>

                            <TextBlock Text="Phone audio is played into this virtual endpoint:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            
                            <ComboBox ItemsSource="{Binding PlaybackDevices}"
                                      SelectedItem="{Binding SelectedPlaybackDevice}"
                                      DisplayMemberPath="Name"
                                      Padding="10,8"
                                      Background="#0F172A"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      FontSize="13"
                                      Margin="0,0,0,10" />

                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="💡 How to use in Discord, Zoom, Teams, OBS:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Set your microphone / input device in those apps to: 'CABLE Output (VB-Audio Virtual Cable)'." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- LIVE AUDIO VU METER CARD -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Live Audio Level (CABLE Input)" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding PeakDbText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                            </Grid>

                            <!-- VU Meter Bar Container -->
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="26" Margin="0,0,0,6">
                                <Grid>
                                    <!-- Dynamic Meter Bar -->
                                    <ProgressBar Value="{Binding PeakLevel, Mode=OneWay}" Minimum="0.0" Maximum="1.0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource AccentBrush}" />

                                    <!-- RMS Level Indicator -->
                                    <ProgressBar Value="{Binding RmsLevel, Mode=OneWay}" Minimum="0.0" Maximum="1.0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Opacity="0.4"
                                                 Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                            </Border>

                            <!-- Decibel Scale Labels -->
                            <Grid Margin="2,0,2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="-48 dB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="-24 dB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="-12 dB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="-6 dB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="0 dB" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="{Binding BufferDepthMs, StringFormat='Buffer Depth: {0:F0} ms'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <!-- AUDIO CONTROLS CARD -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Audio Controls" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <!-- MUTE BUTTON -->
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Content="{Binding MuteButtonText}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="44"
                                    Margin="0,0,0,14" />

                            <!-- OUTPUT GAIN SLIDER -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output Gain" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding GainText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Grid>

                            <Slider Minimum="0.0" Maximum="18.0" Value="{Binding GainDb}" TickFrequency="3.0" IsSnapToTickEnabled="False" Margin="0,0,0,14" />

                            <!-- LIMITER TOGGLE -->
                            <CheckBox IsChecked="{Binding IsLimiterEnabled}" Margin="0,0,0,10">
                                <TextBlock Text="Enable Soft-Knee Limiter (Prevents Digital Clipping)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                            </CheckBox>

                            <!-- DSP PROCESSING: HPF & NOISE GATE -->
                            <CheckBox IsChecked="{Binding IsHighPassFilterEnabled}" Margin="0,0,0,10">
                                <TextBlock Text="Enable 80 Hz High-Pass Filter (Rumble Rejection)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                            </CheckBox>

                            <CheckBox IsChecked="{Binding IsNoiseGateEnabled}" Margin="0,0,0,4">
                                <TextBlock Text="Enable Noise Gate (Room Hiss Rejection)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                            </CheckBox>

                            <Grid Margin="18,0,0,14" IsEnabled="{Binding IsNoiseGateEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="-60.0" Maximum="-20.0" Value="{Binding NoiseGateThresholdDb}" TickFrequency="5.0" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding NoiseGateThresholdText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- LATENCY PROFILE -->
                            <TextBlock Text="Latency Profile:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <UniformGrid Columns="3">
                                <RadioButton Content="Low (40ms)" GroupName="Latency" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"
                                             IsChecked="{Binding SelectedLatencyMode, ConverterParameter={x:Static audio:LatencyMode.Low}}" />
                                <RadioButton Content="Balanced (80ms)" GroupName="Latency" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"
                                             IsChecked="{Binding SelectedLatencyMode, ConverterParameter={x:Static audio:LatencyMode.Balanced}}" />
                                <RadioButton Content="Stable (140ms)" GroupName="Latency" Foreground="{StaticResource TextPrimaryBrush}"
                                             IsChecked="{Binding SelectedLatencyMode, ConverterParameter={x:Static audio:LatencyMode.Stable}}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- SELF-TEST VIRTUAL MICROPHONE CARD -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Virtual Microphone Self-Test" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Play a 2-second safe 440 Hz test tone into CABLE Input to verify that other applications hear the audio:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Button Content="🔊 Test Virtual Microphone"
                                    Command="{Binding StartSelfTestCommand}"
                                    Style="{StaticResource OutlinedButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"
                                    Margin="0,0,0,8" />

                            <TextBlock Text="{Binding TestStatusMessage}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!-- CONNECTED PHONE CARD -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Phone Connection" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Connected Device:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ConnectedClient}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6" />

                                    <TextBlock Text="{Binding ConnectedClientInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Network RTT:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding RttMs, StringFormat='{}{0:F1} ms'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock Text="Frames Streamed:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding FramesReceived}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="📱 Pair Phone (QR Code / PIN)" Command="{Binding OpenPairingDialogCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" />
                            <Button Content="Disconnect Phone" Command="{Binding DisconnectClientCommand}" Style="{StaticResource OutlinedButtonStyle}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <!-- USB STREAMING CARD (ADB REVERSE) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="USB Streaming (ADB Reverse)" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshUsbDevicesCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="10,4" FontSize="11" />
                            </Grid>

                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding UsbStatusColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="USB Status:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UsbStatusText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="💡 For ultra-low latency without Wi-Fi: connect your phone with USB Debugging enabled, and select 'USB Mode' on your phone to stream through the cable." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- LOCAL HEADPHONE MONITORING CARD -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Local Headphone Monitor" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Listen to your own voice in real time for quality checking:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <CheckBox IsChecked="{Binding IsMonitoringEnabled}" Margin="0,0,0,10">
                                <TextBlock Text="Enable Local Monitoring" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            </CheckBox>

                            <TextBlock Text="Monitor Endpoint (Headphones):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding MonitoringDevices}"
                                      SelectedItem="{Binding SelectedMonitoringDevice}"
                                      DisplayMemberPath="Name"
                                      Padding="10,6"
                                      Background="#0F172A"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      FontSize="12"
                                      Margin="0,0,0,10" />

                            <Border Background="#1C1917" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <TextBlock Text="⚠️ Use headphones only. Never monitor through PC speakers when your phone is nearby to avoid acoustic feedback loops." FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SERVER CONFIGURATION CARD -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Server Configuration" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="TCP Listen Port:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="8,6"
                                     FontSize="13"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Available PC Network Addresses:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding LocalIpAddresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid>
                <TextBlock Text="Vixxo Audio Engine • 48 kHz 16-bit Mono PCM • VB-CABLE Shared WASAPI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Close window to minimize to tray" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
