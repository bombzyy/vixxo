<Window x:Class="Vixxo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Vixxo.App.ViewModels"
        xmlns:audio="clr-namespace:Vixxo.Core.Audio;assembly=Vixxo.Core"
        mc:Ignorable="d"
        Title="Vixxo — Studio Virtual Microphone &amp; Soundboard"
        Height="860" Width="1240"
        MinHeight="760" MinWidth="1080"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Main Workspace Shell: Left Sidebar + Main Content Area -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Left Workspace Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 1. LEFT WORKSPACE SIDEBAR                                 -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="#080C14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Brand -->
                    <RowDefinition Height="Auto" /> <!-- Nav Items -->
                    <RowDefinition Height="*" />    <!-- Spacer -->
                    <RowDefinition Height="Auto" /> <!-- Engine Footer -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="VIXXO" FontSize="22" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2" />
                    <TextBlock Text="STUDIO CORE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- Workspace Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="4,0,0,10" />

                    <!-- Studio Nav Button -->
                    <Button Command="{Binding SelectStudioCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStudioTabActive}" Value="True">
                                        <Setter Property="Background" Value="#132B3A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎛️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Studio" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Soundboard Nav Button -->
                    <Button Command="{Binding SelectSoundboardCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSoundboardTabActive}" Value="True">
                                        <Setter Property="Background" Value="#132B3A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Soundboard" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Sound Library & Marketplace Nav Button -->
                    <Button Command="{Binding SelectMarketplaceCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarketplaceTabActive}" Value="True">
                                        <Setter Property="Background" Value="#132B3A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sound Library" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Voice Changer Nav Button (Red Arrow Location) -->
                    <Button Command="{Binding SelectVoiceChangerCommand}" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoiceChangerTabActive}" Value="True">
                                        <Setter Property="Background" Value="#132B3A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Voice Changer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Settings Nav Button -->
                    <Button Command="{Binding SelectSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                                        <Setter Property="Background" Value="#132B3A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Engine Status (Bottom of Sidebar) -->
                <StackPanel Grid.Row="3" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Audio engine running" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="48 kHz • WASAPI Shared" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="13,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. MAIN CONTENT AREA                                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Breadcrumb & Status Bar -->
                <RowDefinition Height="Auto" /> <!-- Driver Missing Warning -->
                <RowDefinition Height="*" />    <!-- Content Switcher -->
                <RowDefinition Height="Auto" /> <!-- Global Footer -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER: BREADCRUMB & STATUS -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding BreadcrumbText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                <!-- Server Info & Dynamic Status Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PrimaryIpAddress}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                            <TextBlock Text=" : " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ListenPort}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="12,5" Background="{Binding StatusColor}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#090D16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Black" Foreground="#090D16" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- MISSING DRIVER ALERT -->
            <Border Grid.Row="1" Background="#3B0D0D" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                    Visibility="{Binding IsVbCableMissing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="⚠️ VB-CABLE Driver Not Detected" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                        <TextBlock Text="Required to stream audio into Discord, Valorant, OBS, Zoom, and Teams." Foreground="#FECACA" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding DriverInstallStatus}" Command="{Binding InstallDriverCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="12,5" FontSize="11" />
                        <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="8,5" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- VIEW A: STUDIO VIEW                                   -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsStudioTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Studio Virtual Microphone" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Ultra-low latency audio pipeline • 48 kHz / 16-bit PCM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Two Column Studio Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Audio Routing, Meter & DSP -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                            <!-- Virtual Mic Routing -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Virtual Microphone Routing" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="8,2" FontSize="10" />
                                    </Grid>
                                    <TextBlock Text="Destination virtual audio endpoint:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <TextBlock Text="💡 In Discord, Valorant, or OBS, choose 'CABLE Output (VB-Audio Virtual Cable)' as your mic." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Live Studio VU Meter -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Live Studio VU Meter" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PeakDbText}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Grid>
                                    <Border Background="#090D16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="24" Margin="0,0,0,6" Padding="2">
                                        <Grid>
                                            <ProgressBar Value="{Binding PeakLevel, Mode=OneWay}" Minimum="0.0" Maximum="1.0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource VuMeterGradient}" />
                                            <ProgressBar Value="{Binding RmsLevel, Mode=OneWay}" Minimum="0.0" Maximum="1.0" Background="Transparent" BorderThickness="0" Opacity="0.4" Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                    </Border>
                                    <Grid Margin="2,0,2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="-48 dB" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="-24 dB" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="-12 dB" FontSize="9" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="-6 dB" FontSize="9" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="0 dB CLIP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DSP Audio Processing -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="DSP Audio Processing" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                    <Button Command="{Binding ToggleMuteCommand}" Content="{Binding MuteButtonText}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,0,0,12" />
                                    
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Software output gain:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GainText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="18.0" Value="{Binding GainDb}" Margin="0,0,0,12" />

                                    <CheckBox IsChecked="{Binding IsLimiterEnabled}" Margin="0,0,0,8">
                                        <TextBlock Text="Soft-knee peak limiter (prevents digital clipping)" FontSize="12" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding IsHighPassFilterEnabled}" Margin="0,0,0,8">
                                        <TextBlock Text="80 Hz high-pass filter (reduces desk rumble &amp; hum)" FontSize="12" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding IsNoiseGateEnabled}" Margin="0,0,0,4">
                                        <TextBlock Text="Dynamic noise gate (cuts room noise &amp; clicks)" FontSize="12" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Quick Voice Changer Status Banner in Studio -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="⚡ Voice Changer" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VoiceChangerStatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RTX 4050 AI Neural &amp; DSP Engine • Dedicated Workspace" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open Studio ›" Command="{Binding SelectVoiceChangerCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="12,6" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: Phone Connection, USB & Monitor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                            <!-- Phone Connection -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Phone Connection" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding ConnectedClient}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding ConnectedClientInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ROUND-TRIP PING" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding RttMs, StringFormat='{}{0:F1} ms'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="FRAMES STREAMED" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FramesReceived}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="📱 Pair phone with QR code or PIN" Command="{Binding OpenPairingDialogCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6" />
                                    <Button Content="Disconnect phone" Command="{Binding DisconnectClientCommand}" Style="{StaticResource OutlinedButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- USB Streaming (Lowest Latency) -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="USB Streaming" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Lowest latency" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </Grid>
                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding UsbStatusColor}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding UsbStatusText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Headphone Monitor -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Headphone Monitor" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Hear your voice in real time while you adjust your setup." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                    <CheckBox IsChecked="{Binding IsMonitoringEnabled}" Margin="0,0,0,8">
                                        <TextBlock Text="Enable headphone monitoring" FontSize="12" />
                                    </CheckBox>
                                    <ComboBox ItemsSource="{Binding MonitoringDevices}" SelectedItem="{Binding SelectedMonitoringDevice}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                                    <Border Background="#251206" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="⚠️ Use headphones to prevent audio feedback screeching." FontSize="10" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- VIEW B: SOUNDBOARD VIEW (MATCHES SCREENSHOT)          -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsSoundboardTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Soundboard Header -->
                    <RowDefinition Height="*" />    <!-- Grid & Output Mix -->
                </Grid.RowDefinitions>

                <!-- Soundboard Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Soundboard" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Play sounds into your virtual microphone." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Manage categories" Style="{StaticResource OutlinedButtonStyle}" Padding="14,8" FontSize="12" Margin="0,0,10,0" />
                        <Button Content="+ Add sound" Command="{Binding AddSoundCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- Main Two-Column Soundboard Section -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: SOUND PADS GRID -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Filter/Search bar -->
                            <RowDefinition Height="*" />    <!-- Scrollable Cards -->
                        </Grid.RowDefinitions>

                        <!-- Search & Category Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="My sounds" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SoundClipsCountText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- Search Input -->
                            <Border Grid.Column="3" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchSoundText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             FontSize="11"
                                             VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Category Dropdown -->
                            <ComboBox Grid.Column="4" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" FontSize="11" Padding="8,4" />
                        </Grid>

                        <!-- Pads Grid (4 Columns) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredSoundPads}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Active Sound Card vs Empty Card -->
                                        <Grid Margin="0,0,10,12" Height="140">
                                            <!-- ACTIVE SOUND PAD -->
                                            <Border CornerRadius="10" Padding="12"
                                                    BorderThickness="1"
                                                    Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Background" Value="#102538" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Header: Title + Shortcut Tag + Delete Button -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        
                                                        <!-- Interactive Key Shortcut Badge -->
                                                        <Button Grid.Column="1" Command="{Binding ChangeShortcutCommand}"
                                                                ToolTip="Click to assign or change global hotkey"
                                                                Margin="4,0" VerticalAlignment="Center" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Text="{Binding ShortcutBadgeText}" FontSize="10" FontWeight="Bold" 
                                                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#182338" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#223652" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="4,1" FontSize="10" Foreground="{StaticResource TextMutedBrush}" ToolTip="Delete this sound" />
                                                    </Grid>

                                                    <!-- Middle Playing Waves (if active) -->
                                                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="● PLAYING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>

                                                    <!-- Footer: Duration & Play Button -->
                                                    <Grid Grid.Row="2">
                                                        <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        <Button Content="▶ Play" Command="{Binding PlayCommand}" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- EMPTY PAD (CLICK TO ADD) -->
                                            <Border CornerRadius="10" Padding="12"
                                                    Background="#080C14"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                                <!-- Clicking empty pad adds a custom sound -->
                                                <Button Command="{Binding PlayCommand}" Style="{StaticResource OutlinedButtonStyle}" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Empty pad" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                                        <TextBlock Text="Add sound" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- RIGHT: OUTPUT MIX PANEL (MATCHES SCREENSHOT) -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Output mix" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Choose where soundboard clips are sent." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                            <!-- Virtual Mic Output Card -->
                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Virtual microphone output" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice}" DisplayMemberPath="Name" FontSize="11" Padding="8,4" />
                                </StackPanel>
                            </Border>

                            <!-- Microphone Volume Slider -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Microphone" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding MicVolumeText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                            </Grid>
                            <Slider Minimum="-18.0" Maximum="6.0" Value="{Binding MicVolumeDb}" Margin="0,0,0,16" />

                            <!-- Soundboard Volume Slider -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Soundboard" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SoundboardVolumeText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                            </Grid>
                            <Slider Minimum="-24.0" Maximum="6.0" Value="{Binding SoundboardVolumeDb}" Margin="0,0,0,18" />

                            <!-- Routing Toggles -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Send clips to virtual mic" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding SendClipsToVirtualMic}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Monitor clips in headphones" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding MonitorClipsInHeadphones}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- NOW PLAYING WIDGET -->
                            <Border Background="#090E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding NowPlayingText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Choose a pad or press shortcut 1-8" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- VIEW B2: SOUND LIBRARY & ONLINE MARKETPLACE VIEW      -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsMarketplaceTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Filter & Search bar -->
                    <RowDefinition Height="*" />    <!-- Scrollable Cards Grid -->
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sound Library &amp; Marketplace" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            <Border Background="#162B3D" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="ONLINE SYNC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Browse authentic Valorant, Meme, and Gaming packs. Click to preview or 1-click download directly into your soundboard and phone Stream Deck." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MarketplaceStatusMessage}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="↻ Refresh" Command="{Binding RefreshMarketplaceCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,8,0" />
                        <Button Content="Go to Soundboard →" Command="{Binding SelectSoundboardCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Filter & Search Sub-Bar -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Category:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MarketplaceCategories}" SelectedItem="{Binding SelectedMarketplaceCategory}" VerticalAlignment="Center" Height="30" />

                        <TextBlock Grid.Column="3" Text="Search:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="4" Text="{Binding MarketplaceSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="30" Padding="8,4" Background="#0C121D" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Sounds: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FilteredMarketplaceSounds.Count}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Cards Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredMarketplaceSounds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="14" Margin="0,0,14,14"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Height="150">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Badge, Category, Duration -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            </Border>

                                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Badge}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Middle Row: Title & Desc -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="32" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Bottom Action Row: Preview Button + Add to Soundboard Button -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Preview Audio Button -->
                                            <Button Grid.Column="0" Command="{Binding PreviewCommand}"
                                                    ToolTip="Preview Sound Online"
                                                    Style="{StaticResource OutlinedButtonStyle}"
                                                    Padding="10,5" FontSize="12">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PlayButtonIcon}" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="Preview" FontSize="11" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Add to Soundboard Button -->
                                            <Button Grid.Column="2" Command="{Binding DownloadCommand}"
                                                    ToolTip="Download and assign to your Soundboard and phone Stream Deck"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="10,5" FontSize="11"
                                                    HorizontalContentAlignment="Center">
                                                <TextBlock Text="{Binding ActionBtnText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- VIEW C: VOICE CHANGER VIEW (AI NEURAL & DSP)         -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsVoiceChangerTabActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Sub-bar: Engine switcher & Custom Model -->
                    <RowDefinition Height="*" />    <!-- Main 2-column workspace -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Real-Time Voice Changer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            <Border Background="#162B3D" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="RTX 4050 ACCELERATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="AI Neural Voice Conversion &amp; Low-Latency Gaming Vocoder" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Top Right Quick Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                            <CheckBox IsChecked="{Binding IsMonitoringEnabled}" VerticalAlignment="Center">
                                <TextBlock Text="🎧 Listen Live in Headphones" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </CheckBox>
                        </Border>
                        <Border Background="#102538" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6">
                            <CheckBox IsChecked="{Binding IsVoiceChangerEnabled}" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Enable Voice Changer" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Sub-bar: Engine Switcher & Actions -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Engine Selector Tabs -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ENGINE MODE:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <!-- AI Neural Tab -->
                            <Button Command="{Binding SelectAiEngineCommand}" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
                                        <Setter Property="Padding" Value="14,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiEngineActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryAccentGradient}" />
                                                <Setter Property="Foreground" Value="#060D1A" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="AI Neural (RVC v2)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Fast DSP Tab -->
                            <Button Command="{Binding SelectFastDspCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
                                        <Setter Property="Padding" Value="14,6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFastDspActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryAccentGradient}" />
                                                <Setter Property="Foreground" Value="#060D1A" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Fast DSP (&lt; 5ms)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Custom Model Import -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Import Custom Model (.pth / .onnx)" Command="{Binding ImportCustomModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Main Workspace: Voice Cards Grid + Tuning Console -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Voice Models Grid -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VoiceModelCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}" Margin="4,4,4,6" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CardBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Emoji + Tag -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="40" Height="40" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding AvatarEmoji}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <Border Grid.Column="1" Background="#111B2C" BorderBrush="{Binding TagColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Foreground="{Binding TagColor}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 1: Name & Subtitle -->
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,1,0,0" />
                                                        </StackPanel>

                                                        <!-- Row 2: Description -->
                                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,10" MinHeight="30" />

                                                        <!-- Row 3: Pitch Badge & Selection Status -->
                                                        <Grid Grid.Row="3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding DefaultPitch, StringFormat='Pitch: {0:+0.0;-0.0;0.0} st'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" />
                                                            </Border>

                                                            <Border Grid.Column="1" x:Name="StatusBadge" Background="Transparent" CornerRadius="4" Padding="6,2">
                                                                <TextBlock x:Name="StatusText" Text="SELECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                                        <Setter TargetName="CardBorder" Property="Background" Value="#152136" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="CardBorder" Property="Background" Value="#142A3D" />
                                                        <Setter TargetName="StatusBadge" Property="Background" Value="#1E4461" />
                                                        <Setter TargetName="StatusText" Property="Text" Value="● ACTIVE" />
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Right: Hardware & Real-Time Tuning Console -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                            <!-- Hardware Acceleration Card -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hardware Acceleration" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Grid.Column="1" Background="#102538" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="NVIDIA CUDA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding GpuHardwareText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="PROCESSING LATENCY" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding GpuLatencyText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="TENSOR PRECISION" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="FP16 Mixed" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Active &amp; streaming to CABLE Input" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Real-Time Voice Tuning Console -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Real-Time Tuning" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                    <!-- Pitch Transpose -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pitch Semitones Shift:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding VoicePitchText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding VoicePitchSemitones}" Margin="0,0,0,14" />

                                    <!-- Formant Shift -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Formant / Vocal Tract Shift:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormantShiftText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Grid>
                                    <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding FormantShift}" Margin="0,0,0,14" />

                                    <!-- Index Rate -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Index Feature Weight (RVC):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding IndexRateText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding IndexRate}" Margin="0,0,0,6" />
                                </StackPanel>
                            </Border>

                            <!-- Tips & Free Models Guide -->
                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="💡 AI Girl &amp; Lady Pro-Tips" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="• 'Sweet Anime Girl' cuts low frequencies below 220 Hz and enhances throat resonance to completely remove male vocal tones." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="• 'Mature Lady' gives a natural, deep, confident female voice ideal for casual Discord and Valorant team chat." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="• Free RVC Models: You can download thousands of characters from weights.gg and drop them directly using '+ Import Custom Model'." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- VIEW D: SETTINGS VIEW                                 -->
            <!-- ===================================================== -->
            <Grid Grid.Row="2" Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Studio Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Configure network endpoints, buffer latency, and hotkeys." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18" />

                        <!-- Server Network Config -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Server Configuration" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="TCP Listen Port:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource SurfaceSubtleBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="8,5" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10" />

                                <TextBlock Text="Local Network Interfaces:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding LocalIpAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Self-Test Audio -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Virtual Audio Diagnostic Test" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="Play 440 Hz test tone into CABLE Input:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <Button Content="🔊 Play Test Tone (440 Hz)" Command="{Binding StartSelfTestCommand}" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding TestStatusMessage}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Software & Updates -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Software &amp; Updates" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="Check GitHub for the latest Vixxo releases, AI voice updates, and bug fixes." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="🔄 Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource OutlinedButtonStyle}" Padding="14,6" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- GLOBAL FOOTER BAR                                     -->
            <!-- ===================================================== -->
            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Connected to virtual audio cable (48 kHz / 16-bit Mono PCM)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Global Hotkeys Active • Click badge to rebind • NumPad0 to stop" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
