<Window x:Class="Vixxo.App.Views.PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Phone — Vixxo"
        Height="620" Width="480"
        MinHeight="560" MinWidth="440"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="../Assets/app.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="Pair Android Phone" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Scan the QR code with Vixxo on your phone or enter the PIN" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- MAIN TABS (QR & PIN / TRUSTED DEVICES) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: QR & PIN -->
            <TabItem Header="QR Code &amp; PIN" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <!-- QR Code Image Container -->
                    <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center" Width="240" Height="240" Margin="0,0,0,14">
                        <Image x:Name="QrCodeImage" Stretch="Uniform" />
                    </Border>

                    <!-- PC IP & Port Display for manual Wi-Fi connection -->
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock x:Name="ServerIpTextBlock" Text="Server IP: 192.168.29.186 : 47800" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Large 6-digit PIN Display -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="MANUAL PAIRING PIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PinTextBlock" Text="000 000" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Expiration Countdown & Refresh -->
                    <TextBlock x:Name="TimerTextBlock" Text="PIN expires in 05:00" FontSize="11" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />

                    <Button Content="🔄 Generate New PIN" Click="OnRefreshPinClick" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Center" Padding="14,6" FontSize="12" />
                </StackPanel>
            </TabItem>

            <!-- TAB 2: TRUSTED DEVICES -->
            <TabItem Header="Paired Devices" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="TrustedDevicesListView" Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding PairedAt, StringFormat='Paired: {0:g}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Revoke" Tag="{Binding DeviceId}" Click="OnRevokeDeviceClick" Style="{StaticResource OutlinedButtonStyle}" Foreground="{StaticResource DangerBrush}" Padding="8,4" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1" Text="Revoking a device prevents it from connecting until paired again." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- CLOSE BUTTON -->
        <Button Grid.Row="2" Content="Close" Click="OnCloseClick" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="16,6" />
    </Grid>
</Window>
